    {
      "name": "a plan that can be approved",
      "plan": [
        "(plan \"Order for Yilmaz Market\"",
        "  (let ((c (erp.find_customer name \"Yilmaz Market\")))",
        "    (if (> (get c balance) (get c limit))",
        "        (stop \"over the limit, balance\" (get c balance))",
        "        (for-each (line (list (record product \"tomatoes\" quantity 20)",
        "                              (record product \"peppers\" quantity 5)))",
        "          (erp.add_order_line customer (get c code) product (get line product) quantity (get line quantity))))))"
      ],
      "tools": {
        "erp.find_customer": [
          {
            "result": {
              "code": "C1",
              "title": "Yilmaz Market",
              "balance": 100,
              "limit": 1000
