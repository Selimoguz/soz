{
  "name": "soz",
  "version": "0.4.0",
  "description": "A plan language a language model writes and a checker proves before anything runs (TypeScript implementation).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p .",
    "conformance": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/conformance.ts",
    "example": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/example.ts",
    "test": "npm run typecheck && npm run conformance && npm run example && npm run define && npm run stores && npm run render && npm run gateway",
    "gateway": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/gateway.test.ts",
    "define": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/define.test.ts",
    "stores": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/stores.test.ts",
    "render": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/render.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "bin": {
    "soz-mcp": "src/soz-mcp.ts",
    "soz-journal": "src/journal-cli.ts"
  }
}
