;;;; json.lisp — Bağımlılıksız, küçük bir JSON okuyucu/yazıcı.
;;;;
;;;; Eşleme:
;;;;   JSON nesnesi  <->  hash-table (anahtarlar string, eşitlik EQUAL)
;;;;   JSON dizisi   <->  vektör (okurken) / liste ya da vektör (yazarken)
;;;;   true/false    <->  :true / :false   (NIL ile karışmasın diye)
;;;;   null          <->  :null
;;;;   sayı, string  <->  sayı, string
;;;;
;;;; Yazarken kolaylık: (json-nesne "a" 1 "b" "x") bir hash-table üretir.

(defpackage :json
  (:use :cl)
  (:export #:json-oku #:json-yaz #:json-nesne #:json-al #:json-hatasi))

(in-package :json)

(define-condition json-hatasi (error)
  ((mesaj :initarg :mesaj :reader mesaj))
  (:report (lambda (c s) (format s "JSON hatası: ~a" (mesaj c)))))

(defun json-nesne (&rest anahtar-degerler)
  "(json-nesne \"model\" \"qwen\" \"stream\" :false) -> hash-table"
  (let ((h (make-hash-table :test #'equal)))
    (loop for (k v) on anahtar-degerler by #'cddr
          do (setf (gethash k h) v))
    h))

(defun json-al (nesne &rest yol)
  "İç içe erişim: (json-al cevap \"message\" \"content\"). Sayı, dizi indisi demektir."
  (dolist (adim yol nesne)
    (setf nesne
          (cond ((null nesne) (return nil))
                ((and (stringp adim) (hash-table-p nesne)) (gethash adim nesne))
                ((and (integerp adim) (vectorp nesne) (< adim (length nesne))) (aref nesne adim))
                (t (return nil))))))

;;; ---------------------------------------------------------------- okuma

(defun json-oku (metin)
  (let ((i 0) (n (length metin)))
    (labels ((hata (m) (error 'json-hatasi :mesaj (format nil "~a (konum ~d)" m i)))
             (bosluk () (loop while (and (< i n) (member (char metin i) '(#\Space #\Tab #\Newline #\Return)))
                              do (incf i)))
             (bak () (bosluk) (if (< i n) (char metin i) (hata "beklenmeyen son")))
             (bekle (c) (if (char= (bak) c) (incf i) (hata (format nil "'~a' bekleniyordu" c))))
             (deger ()
               (let ((c (bak)))
                 (case c
                   (#\{ (nesne))
                   (#\[ (dizi))
                   (#\" (dize))
                   (#\t (sabit "true" :true))
                   (#\f (sabit "false" :false))
                   (#\n (sabit "null" :null))
                   (t (if (or (digit-char-p c) (char= c #\-)) (sayi) (hata (format nil "beklenmeyen '~a'" c)))))))
             (sabit (yazi deger)
               (if (and (<= (+ i (length yazi)) n) (string= yazi metin :start2 i :end2 (+ i (length yazi))))
                   (progn (incf i (length yazi)) deger)
                   (hata "geçersiz sabit")))
             (nesne ()
               (bekle #\{)
               (let ((h (make-hash-table :test #'equal)))
                 (if (char= (bak) #\}) (progn (incf i) h)
                     (loop (let ((k (progn (bak) (dize))))
                             (bekle #\:)
                             (setf (gethash k h) (deger))
                             (case (bak)
                               (#\, (incf i))
                               (#\} (incf i) (return h))
                               (t (hata "',' ya da '}' bekleniyordu"))))))))
             (dizi ()
               (bekle #\[)
               (let ((ogeler '()))
                 (if (char= (bak) #\]) (progn (incf i) (vector))
                     (loop (push (deger) ogeler)
                           (case (bak)
                             (#\, (incf i))
                             (#\] (incf i) (return (coerce (nreverse ogeler) 'vector)))
                             (t (hata "',' ya da ']' bekleniyordu")))))))
             (dize ()
               (bekle #\")
               (with-output-to-string (s)
                 (loop (when (>= i n) (hata "kapanmamış dize"))
                       (let ((c (char metin i)))
                         (incf i)
                         (cond ((char= c #\") (return))
                               ((char= c #\\)
                                (let ((e (char metin i)))
                                  (incf i)
                                  (case e
                                    (#\n (write-char #\Newline s))
                                    (#\t (write-char #\Tab s))
                                    (#\r (write-char #\Return s))
                                    (#\b (write-char #\Backspace s))
                                    (#\f (write-char #\Page s))
                                    (#\u (write-char (unicode s) s))
                                    (t (write-char e s)))))
                               (t (write-char c s)))))))
             (hex4 ()
               (prog1 (parse-integer metin :start i :end (+ i 4) :radix 16) (incf i 4)))
             (unicode (s)
               (declare (ignore s))
               (let ((kod (hex4)))
                 ;; UTF-16 vekil çifti: 😀
                 (if (and (<= #xD800 kod #xDBFF) (< (+ i 1) n) (char= (char metin i) #\\) (char= (char metin (1+ i)) #\u))
                     (progn (incf i 2)
                            (let ((alt (hex4)))
                              (code-char (+ #x10000 (ash (- kod #xD800) 10) (- alt #xDC00)))))
                     (code-char kod))))
             (sayi ()
               (let ((bas i))
                 (loop while (and (< i n) (find (char metin i) "+-0123456789.eE")) do (incf i))
                 (let ((yazi (subseq metin bas i)))
                   (if (every (lambda (c) (or (digit-char-p c) (char= c #\-))) yazi)
                       (parse-integer yazi)
                       ;; soz: decimals are read exactly (12.5 -> 25/2, 0.1 -> 1/10), never as floats.
                       (let* ((e (position-if (lambda (c) (char-equal c #\e)) yazi))
                              (mant (subseq yazi 0 e))
                              (us (if e (parse-integer yazi :start (1+ e)) 0))
                              (neg (and (plusp (length mant)) (char= (char mant 0) #\-)))
                              (g (string-left-trim "-" mant))
                              (dot (position #\. g)))
                         (unless (and (plusp (length g)) (every (lambda (c) (or (digit-char-p c) (char= c #\.))) g)
                                      (<= (count #\. g) 1))
                           (hata "geçersiz sayı"))
                         (let ((v (* (+ (if (and dot (zerop dot)) 0 (parse-integer g :end dot))
                                        (if (and dot (< (1+ dot) (length g)))
                                            (/ (parse-integer g :start (1+ dot)) (expt 10 (- (length g) dot 1)))
                                            0))
                                     (expt 10 us))))
                           (if neg (- v) v))))))))
      (prog1 (deger)
        (bosluk)
        (when (< i n) (hata "fazladan karakter"))))))

;;; ---------------------------------------------------------------- yazma

(defun dize-yaz (str s)
  (write-char #\" s)
  (loop for c across str
        do (case c
             (#\" (write-string "\\\"" s))
             (#\\ (write-string "\\\\" s))
             (#\Newline (write-string "\\n" s))
             (#\Return (write-string "\\r" s))
             (#\Tab (write-string "\\t" s))
             (t (if (< (char-code c) 32)
                    (format s "\\u~4,'0x" (char-code c))
                    (write-char c s)))))
  (write-char #\" s))

(defun json-yaz (deger &optional (s nil))
  "Değeri JSON metnine çevirir. S verilmezse string döner."
  (if (null s)
      (with-output-to-string (out) (json-yaz deger out))
      (cond ((eq deger :true) (write-string "true" s))
            ((or (eq deger :false) (null deger)) (write-string "false" s))
            ((eq deger :null) (write-string "null" s))
            ((stringp deger) (dize-yaz deger s))
            ((integerp deger) (format s "~d" deger))
            ((realp deger) (let ((*read-default-float-format* 'double-float))
                             (format s "~f" (coerce deger 'double-float))))
            ((hash-table-p deger)
             (write-char #\{ s)
             (let ((ilk t))
               (maphash (lambda (k v)
                          (unless ilk (write-char #\, s))
                          (setf ilk nil)
                          (dize-yaz (string k) s)
                          (write-char #\: s)
                          (json-yaz v s))
                        deger))
             (write-char #\} s))
            ((or (listp deger) (vectorp deger))
             (write-char #\[ s)
             (let ((ilk t))
               (map nil (lambda (v)
                          (unless ilk (write-char #\, s))
                          (setf ilk nil)
                          (json-yaz v s))
                    deger))
             (write-char #\] s))
            ((symbolp deger) (dize-yaz (string-downcase (symbol-name deger)) s))
            (t (error 'json-hatasi :mesaj (format nil "yazılamayan değer: ~s" deger))))))
