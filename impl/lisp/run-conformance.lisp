;;;; run-conformance.lisp — Runs the conformance suite against the Lisp reference checker.
;;;; sbcl --script impl/lisp/run-conformance.lisp [conformance-folder]

(setf sb-impl::*default-external-format* :utf-8)
(load (merge-pathnames "json.lisp" *load-truename*))
(load (merge-pathnames "soz.lisp" *load-truename*))
(load (merge-pathnames "run.lisp" *load-truename*))

(defpackage :soz-conformance (:use :cl :soz))
(in-package :soz-conformance)

(defun read-file (path)
  (with-open-file (s path :external-format :utf-8)
    (let ((text (make-string (file-length s))))
      (subseq text 0 (read-sequence text s)))))

(defun read-json (path) (json:json-oku (read-file path)))

(defun plan-text (p)
  (if (stringp p) p (format nil "~{~a~^~%~}" (coerce p 'list))))

(defun json-bool (v) (eq v :true))

(defvar *problems*)
(defun problem (fmt &rest args) (push (apply #'format nil fmt args) *problems*))

(defun error-matches-p (want got)
  (and (string= (gethash "code" want) (soz-error-code got))
       (or (null (gethash "line" want))
           (and (= (gethash "line" want) (soz-error-line got))
                (= (gethash "column" want) (soz-error-column got))))))

(defun describe-errors (errors)
  (format nil "~{~a~^, ~}" (mapcar (lambda (e) (format nil "~a@~d:~d" (soz-error-code e) (soz-error-line e) (soz-error-column e)))
                                    errors)))

(defun compare (expect r)
  (multiple-value-bind (v present) (gethash "valid" expect)
    (when (and present (not (eq (json-bool v) (result-valid r))))
      (problem "valid: expected ~a, got ~a (errors: ~a)" (json-bool v) (result-valid r) (describe-errors (result-errors r)))))
  (let ((want (coerce (or (gethash "errors" expect) #()) 'list))
        (got (result-errors r)))
    (dolist (w want)
      (unless (find-if (lambda (g) (error-matches-p w g)) got)
        (problem "missing error ~a~@[ at ~d~]~@[:~d~] (got: ~a)" (gethash "code" w) (gethash "line" w) (gethash "column" w)
                 (describe-errors got))))
    (when (and (json-bool (gethash "only" expect)) (/= (length want) (length got)))
      (problem "expected exactly ~d error(s), got ~d: ~a" (length want) (length got) (describe-errors got))))
  (multiple-value-bind (v present) (gethash "effects" expect)
    (when (and present (not (equal (coerce v 'list) (result-effects r))))
      (problem "effects: expected ~a, got ~a" (coerce v 'list) (result-effects r))))
  (loop for (key fn) in (list (list "requires_approval" #'result-requires-approval) (list "may_stop" #'result-may-stop))
        do (multiple-value-bind (v present) (gethash key expect)
             (when (and present (not (eq (json-bool v) (and (funcall fn r) t))))
               (problem "~a: expected ~a, got ~a" key (json-bool v) (funcall fn r)))))
  (multiple-value-bind (v present) (gethash "max_calls" expect)
    (when (and present (/= v (result-max-calls r)))
      (problem "max_calls: expected ~d, got ~d" v (result-max-calls r))))
  (multiple-value-bind (v present) (gethash "calls" expect)
    (when present
      (let ((got (gethash "calls" (result-json r))))
        (if (/= (length v) (length got))
            (problem "calls: expected ~d, got ~d" (length v) (length got))
            (loop for w across v for g across got for i from 1
                  do (maphash (lambda (k wv)
                                (unless (equal wv (gethash k g))
                                  (problem "call ~d ~a: expected ~a, got ~a" i k wv (gethash k g))))
                              w)))))))

;;; --- Execution cases (SPEC 10): scripted operations, journal, preview, execute

(defun canon (x) (canonical-json x))

(defun install-scripts (tools log)
  "Every operation in TOOLS answers from its script, in order; the last answer repeats."
  (setf *implementations* (make-hash-table :test #'equal))
  (when tools
    (maphash (lambda (name script)
               (let ((i 0))
                 (setf (gethash (name-fold name) *implementations*)
                       (lambda (args)
                         (vector-push-extend (cons name args) log)
                         (let ((r (aref script (min i (1- (length script))))))
                           (incf i)
                           (multiple-value-bind (v present) (gethash "result" r)
                             (cond (present v)
                                   ((gethash "failed" r) (error 'operation-failed :message (gethash "failed" r)))
                                   (t (error 'operation-unknown :message (gethash "unknown" r))))))))))
             tools)))

(defun preload-journal (entries)
  (let ((j (make-journal)))
    (loop for e across (or entries #())
          do (let* ((op (gethash (name-fold (gethash "operation" e)) *operations*))
                    (args (loop for k being the hash-keys of (gethash "args" e) using (hash-value v)
                                collect (cons k (soz::from-host v :any "journal")))))
               (soz::journal-put j (soz::step-key-text op args) (or (gethash "status" e) "done") :null)))
    j))

(defun compare-steps (want got fields)
  (if (/= (length want) (length got))
      (problem "steps: expected ~d, got ~d" (length want) (length got))
      (loop for w across want for g in got for i from 1
            do (maphash (lambda (k wv)
                          (let ((gv (cdr (assoc k fields :test #'string=))))
                            (unless (equal (canon wv) (canon (funcall gv g)))
                              (problem "step ~d ~a: expected ~a, got ~a" i k (canon wv) (canon (funcall gv g))))))
                        w))))

(defparameter *step-fields*
  (list (cons "operation" (lambda (s) (soz::op-name (step-operation s))))
        (cons "args" #'step-args)
        (cons "already_done" (lambda (s) (if (step-already-done s) :true :false)))
        (cons "index" #'step-index)
        (cons "requires" (lambda (s) (map 'vector (lambda (r) (soz::obj "role" (first r) "four_eyes" (if (second r) :true :false)
                                                                        "rule" (third r)))
                                          (step-requires s))))
        (cons "status" #'step-status)))

(defun compare-preview (expect p)
  (flet ((same (key got)
           (multiple-value-bind (v present) (gethash key expect)
             (when (and present (not (equal (canon v) (canon got))))
               (problem "~a: expected ~a, got ~a" key (canon v) (canon got))))))
    (same "status" (preview-status p))
    (same "hash" (or (preview-hash p) :null))
    (same "stop_reason" (or (preview-stop-reason p) :null))
    (multiple-value-bind (v present) (gethash "problems" expect)
      (when present
        (let ((codes (mapcar (lambda (pr) (cdr (assoc "code" (cdr pr) :test #'string=))) (preview-problems p))))
          (unless (equal (coerce v 'list) codes)
            (problem "problems: expected ~a, got ~a ~a" (coerce v 'list) codes
                     (mapcar (lambda (pr) (cdr (assoc "message" (cdr pr) :test #'string=))) (preview-problems p)))))))
    (multiple-value-bind (v present) (gethash "steps" expect)
      (when present (compare-steps v (preview-steps p) *step-fields*)))))

(defun compare-execution (expect e log)
  (flet ((same (key got)
           (multiple-value-bind (v present) (gethash key expect)
             (when (and present (not (equal (canon v) (canon got))))
               (problem "~a: expected ~a, got ~a~@[ (~a)~]" key (canon v) (canon got) (execution-message e))))))
    (same "outcome" (execution-outcome e))
    (same "stop_reason" (or (execution-stop-reason e) :null))
    (multiple-value-bind (v present) (gethash "steps" expect)
      (when present (compare-steps v (execution-steps e) *step-fields*)))
    (multiple-value-bind (v present) (gethash "calls" expect)
      (when present
        (if (/= (length v) (length log))
            (problem "calls: expected ~d, got ~d: ~{~a~^, ~}" (length v) (length log) (map 'list #'car log))
            (loop for w across v for (name . args) across log for i from 1
                  do (let ((wname (if (stringp w) w (gethash "operation" w))))
                       (unless (string= wname name) (problem "call ~d: expected ~a, got ~a" i wname name))
                       (when (and (hash-table-p w) (gethash "args" w) (not (equal (canon (gethash "args" w)) (canon args))))
                         (problem "call ~d args: expected ~a, got ~a" i (canon (gethash "args" w)) (canon args))))))))))

(defvar *case-policy* '())
(defvar *case-actor* nil)

(defun run-execution-case (c message)
  (let* ((text (plan-text (gethash "plan" c)))
         (journal (preload-journal (gethash "journal" c)))
         (log (make-array 0 :adjustable t :fill-pointer t)))
    (install-scripts (gethash "tools" c) log)
    (let ((p (preview text :message message :journal journal :policy *case-policy* :actor *case-actor*)))
      (when (gethash "expect_preview" c) (compare-preview (gethash "expect_preview" c) p))
      (when (gethash "expect_execute" c)
        (let ((log2 (make-array 0 :adjustable t :fill-pointer t)))
          (install-scripts (or (gethash "execute_tools" c) (gethash "tools" c)) log2)
          (let ((e (execute p (if (eq (gethash "approve" c) :false) "wrong" (preview-hash p)) :journal journal
                            :approvers (map 'list #'actor-from-json (or (gethash "approvers" c) #())))))
            (compare-execution (gethash "expect_execute" c) e log2)
            (when (gethash "expect_execute_again" c)
              (let ((log3 (make-array 0 :adjustable t :fill-pointer t)))
                (install-scripts (or (gethash "execute_tools" c) (gethash "tools" c)) log3)
                (compare-execution (gethash "expect_execute_again" c)
                                   (execute p (preview-hash p) :journal journal) log3)))))))))

(defun run (folder)
  (let ((total 0) (failed 0))
    (setf *operations* (make-hash-table :test #'equal))
    (map nil #'operation-from-json (read-json (merge-pathnames "operations.json" folder)))
    (dolist (file (sort (directory (merge-pathnames "cases/*.json" folder)) #'string< :key #'namestring))
      (let* ((suite (read-json file)))
        (format t "~%~a~%" (file-namestring file))
        (loop for c across (gethash "cases" suite)
              do (multiple-value-bind (m present) (gethash "message" c)
                   (let* ((message (if present m (gethash "message" suite)))
                          (message (if (stringp message) message nil))
                          (*case-policy* (policy-from-json (or (gethash "policy" c) (gethash "policy" suite) #())))
                          (*case-actor* (actor-from-json (multiple-value-bind (a here) (gethash "actor" c)
                                                           (if here a (gethash "actor" suite)))))
                          (*problems* '()))
                     (if (nth-value 1 (gethash "tools" c))
                         (run-execution-case c message)
                         (compare (gethash "expect" c)
                                  (check-plan (plan-text (gethash "plan" c)) :message message
                                              :policy *case-policy* :actor *case-actor*
                                              ;; "profile": a name in profiles/, next to conformance/
                                              :profile (let ((name (multiple-value-bind (pn here) (gethash "profile" c)
                                                                     (if here pn (gethash "profile" suite)))))
                                                         (and (stringp name)
                                                              (profile-from-json
                                                               (read-json (merge-pathnames (format nil "../profiles/~a.json" name) folder))))))))
                     (incf total)
                     (if *problems*
                         (progn (incf failed)
                                (format t "  FAIL  ~a~%~{          ~a~%~}" (gethash "name" c) (reverse *problems*)))
                         (format t "  ok    ~a~%" (gethash "name" c))))))))
    (format t "~%~d cases, ~d failed~%" total failed)
    (zerop failed)))

(let* ((arg (second sb-ext:*posix-argv*))
       (folder (if arg
                   (pathname (if (find (char arg (1- (length arg))) "/\\") arg (concatenate 'string arg "/")))
                   (merge-pathnames "../../conformance/" *load-truename*))))
  (sb-ext:exit :code (if (run folder) 0 1)))
