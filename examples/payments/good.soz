(plan "Pay invoice INV-2026-118"
  (let ((invoice (bank.find_invoice number "INV-2026-118"))
        (account (bank.balance)))
    (if (!= (get invoice amount) 12450.75)
        (stop "The invoice says" (get invoice amount) (get invoice currency)
              "but the request says 12.450,75 TRY. Check before paying.")
        (if (< (get account available) (get invoice amount))
            (stop "Not enough money:" (get account available) "available.")
            (bank.pay to_iban (get invoice iban) amount (get invoice amount)
                      currency (get invoice currency) reference (get invoice number))))))
